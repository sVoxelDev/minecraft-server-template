#!/usr/bin/env python3
import argparse
import json
import socket
import struct


def varint(value):
    result = bytearray()
    while True:
        byte = value & 127
        value >>= 7
        result.append(byte | (128 if value else 0))
        if not value:
            return bytes(result)


def read_exact(connection, count):
    result = b''
    while len(result) < count:
        data = connection.recv(count - len(result))
        if not data:
            raise ConnectionError('Minecraft closed the connection.')
        result += data
    return result


def read_varint(connection):
    value = 0
    for offset in range(5):
        byte = read_exact(connection, 1)[0]
        value |= (byte & 127) << (offset * 7)
        if not byte & 128:
            return value
    raise ValueError('Invalid Minecraft packet length.')


def status(host, port):
    with socket.create_connection((host, port), timeout=10) as connection:
        address = host.encode()
        handshake = b'\x00' + varint(775) + varint(len(address)) + address + struct.pack('>H', port) + b'\x01'
        connection.sendall(varint(len(handshake)) + handshake + b'\x01\x00')
        read_varint(connection)
        if read_varint(connection) != 0:
            raise ValueError('Expected status packet.')
        length = read_varint(connection)
        if length > 1024 * 1024:
            raise ValueError('Status response exceeds limit.')
        return json.loads(read_exact(connection, length))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Query the actual Minecraft status protocol.')
    parser.add_argument('--host', default='127.0.0.1')
    parser.add_argument('--port', type=int, default=25565)
    args = parser.parse_args()
    print(json.dumps(status(args.host, args.port), sort_keys=True))
